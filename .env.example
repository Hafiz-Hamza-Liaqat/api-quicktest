# ==============================================================================
# API QuickTest — Environment Configuration Reference
# ==============================================================================

# Frontend (Vite) Configuration
# URL of the API QuickTest Node.js proxy service.
# For local development: http://localhost:3001
# For production: https://api-quicktest-proxy.onrender.com (or your custom domain)
VITE_API_PROXY_URL=http://localhost:3001

# Backend (Node.js Proxy) Configuration
PORT=3001
NODE_ENV=development

# Maximum requests per minute allowed per client IP
RATE_LIMIT_MAX=120

# Comma-separated list of allowed frontend origins for CORS
# In production, restrict to your GitHub Pages URL or custom domain
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,https://hafiz-hamza-liaqat.github.io

# Allow localhost/loopback destinations strictly for local development testing
# MUST be false or omitted in production to guarantee SSRF protection
ALLOW_LOCALHOST=false

# Trusted Reverse Proxy Configuration
# When deployed behind Render, Cloudflare, or AWS ALB, set to 1 (or number of trusted proxy hops).
# Express uses this to reliably determine client IP without trusting spoofed X-Forwarded-For headers.
# For direct local connections, leave unset or false.
TRUST_PROXY=1
